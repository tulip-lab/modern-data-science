{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tulip-lab/modern-data-science/blob/develop/offerings/offering-manifest.schema.json",
  "title": "Modern Data Science Offering Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "institution",
    "unit",
    "offering",
    "status",
    "common_core_version",
    "modules",
    "public_assessment_artifacts",
    "policy_links"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "institution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9-]+$"},
        "name": {"type": "string", "minLength": 1}
      }
    },
    "offering": {"type": "string", "pattern": "^[A-Za-z0-9-]+$"},
    "status": {"enum": ["planned", "active", "superseded", "archived"]},
    "common_core_version": {"type": "string", "minLength": 7},
    "modules": {
      "type": "array",
      "items": {"type": "string", "pattern": "^M[0-9]{2}$"},
      "uniqueItems": true
    },
    "public_assessment_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["classification", "path_or_url", "canonical_source"],
        "properties": {
          "classification": {
            "enum": ["brief", "public_rubric", "dataset", "starter_code", "submission_template", "support_guide"]
          },
          "path_or_url": {"type": "string", "minLength": 1},
          "canonical_source": {"type": "string", "minLength": 1}
        }
      }
    },
    "policy_links": {
      "type": "array",
      "items": {"type": "string", "format": "uri"},
      "uniqueItems": true
    },
    "supersedes": {"type": ["string", "null"]},
    "notes": {"type": "string"}
  }
}
